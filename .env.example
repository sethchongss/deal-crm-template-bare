# Public Supabase settings. These are exposed to the browser.
# Use the project URL and the anon (or publishable) key. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only scrypt hash of the shared password. Never put the plaintext password here.
# Generate with: TEAM_PASSWORD='the password' node scripts/hash-password.mjs
# Format: scrypt:16384:8:1:<saltB64>:<hashB64>
# Colons, not dollar signs: Next.js expands $ in .env files.
TEAM_PASSWORD_HASH=

# Server-only. Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Server-only. Comma-separated team allow-list. The first address is the shared Supabase login.
# Add the same addresses to the private.team_emails table (see docs/SETUP.md, section 3).
TEAM_ALLOWED_EMAILS=crm@your-domain.com

# Server-only. Random password for the shared Supabase user (first address in TEAM_ALLOWED_EMAILS).
# Generate with: openssl rand -base64 32
# Hash this exact value in the SQL in docs/SETUP.md. Do not use it as the typed password.
SUPABASE_TEAM_PASSWORD=

# Server-only. Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Server-only. Signs OAuth clients, consent forms, and MCP access tokens.
# Set on Production, Preview, and local Development. Generate with: openssl rand -base64 32
# The connector refuses to start authorization until this is at least 16 characters.
MCP_TOKEN_SECRET=

# Optional. Display name in the title, sidebar, and Claude connector. Defaults to "Deal CRM Template".
NEXT_PUBLIC_APP_NAME=

# Recommended. Comma-separated public hosts allowed for OAuth/MCP metadata, e.g. your-app.vercel.app,crm.your-domain.com
# The first one is the canonical host. localhost is always allowed. On Vercel, the deploy's own hosts
# (VERCEL_PROJECT_PRODUCTION_URL, VERCEL_BRANCH_URL, VERCEL_URL) are allowed automatically.
# With nothing configured, an unrecognised host falls back to http://localhost:3000.
APP_PUBLIC_HOSTS=
